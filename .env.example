# Copy to .env and fill in values. NautiCAI repo root (folder that contains openclaw/).

# --- Local dev: skip JWT/session DB lookup for /api/inspect* (OpenClaw + testing) ---
# Never enable in production. If DB inserts fail, set NAUTICAI_SKIP_AUTH_USER_ID to your users.id.
# NAUTICAI_SKIP_AUTH=1
# NAUTICAI_SKIP_AUTH_USER_ID=1

# --- Database (Agentic backend auth) ---
# POSTGRES_DSN=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- OpenClaw: auto-inspect when files appear in a folder ---
# Run backend first, then: python3 openclaw/watcher.py (from this repo root)
BACKEND_URL=http://127.0.0.1:8000
# JWT from the web app after login (Application → Local Storage → nauticai:token) or signup/login API.
# Must be the same account you use in the browser if NAUTICAI_SKIP_AUTH is off — otherwise reports land under a different user_id folder.
OPENCLAW_API_TOKEN=
# Folder to watch (create it if needed). Default if unset: <repo>/incoming
# Linux: OPENCLAW_INCOMING_DIR=/home/you/Downloads/check
# Windows (use forward slashes): OPENCLAW_INCOMING_DIR=C:/Users/You/Downloads/NautiCAI_hull
# Optional second watch folder for pipeline images (one watcher watches both):
# OPENCLAW_PIPELINE_INCOMING_DIR=C:/Users/You/Downloads/NautiCAI_Pipeline
# One combined PDF/report for all images in the same quiet window (mixed filenames OK):
#   OPENCLAW_BATCH_KEY_MODE=global
# In global mode, hull and pipeline are separated into independent batches.
# Batch vessel_id sent to API (Dashboard / Reports / PDF filenames):
#   OPENCLAW_BATCH_VESSEL_MODE=unique   (default) → hull1, hull2, pipeline1, … (separate counters per source)
#   OPENCLAW_BATCH_VESSEL_MODE=global   → use OPENCLAW_GLOBAL_VESSEL_ID (+ _pipeline for pipeline)
# Optional stable vessel_id base when mode=global (pipeline appends "_pipeline"):
#   OPENCLAW_GLOBAL_VESSEL_ID=my_hull_batch
# Alternative: keep vessel mode but force the same vessel id for every filename (merges batches):
#   OPENCLAW_FORCE_VESSEL_ID=my_vessel
# Source tag sent to backend: auto|hull|pipeline (auto infers from folder name/path, defaults to hull)
# OPENCLAW_INSPECTION_SOURCE=auto
# If true, files are deleted from incoming after processing (success/failure) instead of moved.
# OPENCLAW_DELETE_AFTER_INSPECTION=true
# OPENCLAW_PROCESSED_DIR=
# OPENCLAW_FAILED_DIR=
# OPENCLAW_HEALTH_URL=/health

# --- Hull vision engine (Agentic backend) ---
# Per-source routing (recommended): hull folder -> prasad, pipeline folder -> aishwarya
# NAUTICAI_HULL_FOLDER_ENGINE=prasad
# NAUTICAI_PIPELINE_FOLDER_ENGINE=aishwarya
# Global fallback when no source tag is provided:
# NAUTICAI_HULL_ENGINE=agentic
# Folder with Prasad-trained weights (.pt/.engine), same layout as their project root.
# If unset, backend defaults to: NautiCAI/AgenticAI_Backend/NautiCAI AI/NautiCAI_Backend/prasad_models
# NAUTICAI_PRASAD_MODEL_DIR=C:/path/to/weights_folder
# (alias) NAUTICAI_PRASAD_REPO=...
#
# Aishwarya model folder / selector (inside NautiCAI backend):
# NAUTICAI_AISHWARYA_MODEL_DIR=C:/path/to/aishwarya_models
# NAUTICAI_AISHWARYA_MODEL_PATH=C:/path/to/model.pt
# If unset: hull Aishwarya defaults to merged_original; inspection_source=pipeline defaults to subpipe_full.
# NAUTICAI_AISHWARYA_MODEL_KEY=merged_original
# NAUTICAI_AISHWARYA_PIPELINE_MODEL_KEY=subpipe_full
# NAUTICAI_AISHWARYA_CONF=0.2
# NAUTICAI_AISHWARYA_IOU=0.45
# NAUTICAI_AISHWARYA_IMGSZ=1280
# NAUTICAI_AISHWARYA_MIN_BOX_AREA_RATIO=0
# NAUTICAI_OUTPUT_DIR=C:/path/to/pipeline_outputs
# Optional enhancement controls:
# NAUTICAI_AISHWARYA_USE_CLAHE=true
# NAUTICAI_AISHWARYA_USE_GREEN=true
# NAUTICAI_AISHWARYA_USE_EDGE=false
# NAUTICAI_AISHWARYA_TURBIDITY=0.0
# NAUTICAI_AISHWARYA_CORRECT_TURBIDITY=true
# NAUTICAI_AISHWARYA_CLAHE_CLIP=3.0

# --- Optional: same as backend Telegram ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# After /api/inspect: push summary+PDF to TELEGRAM_CHAT_ID (telegram_notify module).
# openclaw (default) = only when OpenClaw sends X-NauticAI-Client: openclaw (manual web uploads stay quiet).
# all = every successful HTTP inspect also notifies. off = never from API (watcher can still send its own texts).
# NAUTICAI_TELEGRAM_NOTIFY_HTTP_INSPECT=openclaw

# --- Frontend / email (if used) ---
# FRONTEND_URL=http://localhost:3000
# BREVO_SMTP_USER=
# BREVO_SMTP_KEY=

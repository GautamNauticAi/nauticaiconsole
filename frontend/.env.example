# Backend (browser uses /api/backend proxy on Vercel)
NEXT_PUBLIC_API_URL=https://your-cloud-run-url.run.app

# AWS S3 ingestion (server-only — set on Vercel, not NEXT_PUBLIC_)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_INGESTION_BUCKET=your-ingestion-bucket
# Optional; default "incoming" → keys like incoming/hull/... and incoming/pipeline/...
AWS_S3_INGESTION_PREFIX=incoming

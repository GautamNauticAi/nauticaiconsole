# =============================================================================
# NautiCAI Agentic backend — Jetson / Tegra (L4T, Xavier, Orin Nano/AGX, etc.)
# =============================================================================
# How to use:
#   1. Copy this file to `.env` in this folder (or any parent folder of `nauticai_api.py`).
#   2. Fill secrets (database, Telegram) as needed.
#   3. Restart the API (e.g. `python nauticai_api.py`).
#
# The loader in `nauticai_api.py` merges multiple `.env` files from repo root downward;
# values in a deeper `.env` override earlier ones.
# =============================================================================

# -----------------------------------------------------------------------------
# Device profile (video + tuning)
# -----------------------------------------------------------------------------
# Auto-detection: Jetson is detected via `/etc/nv_tegra_release` or
# `/proc/device-tree/model` containing "jetson" / "tegra" on aarch64.
# Set this to override (e.g. test Jetson defaults on a PC, or force server behavior).
NAUTICAI_DEVICE_PROFILE=jetson

# -----------------------------------------------------------------------------
# Still images + every sampled video frame (YOLO + SAM — main GPU/CPU cost)
# -----------------------------------------------------------------------------
# Resize so max(width,height) <= this before inference. Strongly recommended on
# Jetson (try 1024–1280). Set 0 to disable (not recommended on edge).
NAUTICAI_MAX_INFERENCE_SIZE=1280

# Model paths (uncomment and set if not next to the backend script)
# NAUTICAI_YOLO_PATH=/path/to/biofouling_best.pt
# NAUTICAI_SAM_PATH=/path/to/sam_vit_b_01ec64.pth
# NAUTICAI_OUTPUT_DIR=pipeline_outputs

# -----------------------------------------------------------------------------
# Video: sampled frames (each frame runs the full inspection pipeline)
# -----------------------------------------------------------------------------
# If you do NOT set the three variables below, Jetson auto-defaults apply:
#   • NAUTICAI_VIDEO_MAX_FRAMES=6          (desktop default would be 10)
#   • NAUTICAI_VIDEO_FRAME_INTERVAL_SEC=2.5 (desktop default would be 1.5)
#   • NAUTICAI_VIDEO_MAX_SIDE=1280          (downscale extracted frames; 0=off on desktop)
#
# Override explicitly for your board (examples):

# Balanced (default Jetson behavior when vars omitted)
# NAUTICAI_VIDEO_MAX_FRAMES=6
# NAUTICAI_VIDEO_FRAME_INTERVAL_SEC=2.5
# NAUTICAI_VIDEO_MAX_SIDE=1280

# More throughput (Orin AGX / good cooling)
# NAUTICAI_VIDEO_MAX_FRAMES=10
# NAUTICAI_VIDEO_FRAME_INTERVAL_SEC=2.0
# NAUTICAI_VIDEO_MAX_SIDE=1280

# Minimal load (Nano, thermal limits, long clips)
# NAUTICAI_VIDEO_MAX_FRAMES=4
# NAUTICAI_VIDEO_FRAME_INTERVAL_SEC=3.5
# NAUTICAI_VIDEO_MAX_SIDE=1024
# NAUTICAI_MAX_INFERENCE_SIZE=1024

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# PORT=8000
# FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Auth + Postgres (optional; required for multi-user / Telegram user linking)
# -----------------------------------------------------------------------------
# POSTGRES_DSN=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# JWT_SECRET=change-me
# RESET_SECRET=change-me
#
# Edge / OpenClaw often uses skip-auth (no Bearer session). Reports still write to disk under reports/{id}/.
# If POSTGRES_DSN is set, inspections also INSERT into agentic_inspections — that user_id must exist in users.
# NAUTICAI_SKIP_AUTH=1
# NAUTICAI_SKIP_AUTH_USER_ID=42          # must match an existing users.id in YOUR database (not always 1)
# NAUTICAI_SKIP_AUTH_EMAIL=dev@local
# NAUTICAI_SKIP_AUTH_USERNAME=dev

# -----------------------------------------------------------------------------
# Telegram notifications (optional)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Jetson runtime notes
# -----------------------------------------------------------------------------
# • `nauticai_api.py` and `nauticai_hull_inspection.py` prepend common Tegra/CUDA
#   library paths on Linux; you can still set LD_LIBRARY_PATH in systemd or ~/.bashrc:
#     export LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu/tegra:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}
# • Install PyTorch from NVIDIA’s JetPack wheel only; do not `pip install torch`
#   from PyPI on device (see `scripts/install_jetson_backend.sh`).
# • Optional: start the bundled Telegram bot with the backend
#     NAUTICAI_START_TELEGRAM_BOT=1
# =============================================================================
